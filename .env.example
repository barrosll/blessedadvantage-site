# Variáveis de ambiente da loja Welabb.
# Copiar para ".env" (testes locais) e definir as mesmas na Netlify: Site configuration → Environment variables.
# NUNCA colocar valores reais neste ficheiro — ele está no GitHub.

# --- Gestão ---------------------------------------------------------------
ADMIN_PASSWORD=                # mínimo 12 caracteres

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=             # sk_test_… (testes) / sk_live_… (produção)
STRIPE_WEBHOOK_SECRET=         # whsec_… do endpoint https://<domínio>/api/stripe-webhook

# --- Loja -----------------------------------------------------------------
MAINTENANCE_MODE=              # 1 = loja fechada ("Voltamos em breve")
PACKAGE_WEIGHT_KG=             # peso da embalagem somado a cada envio, ex.: 0.15

# --- Emails (Resend) -----------------------------------------------------
RESEND_API_KEY=                # re_…
EMAIL_FROM=                    # ex.: Welabb <encomendas@blessedadvantage.pt>
EMAIL_REPLY_TO=                # caixa de email que lê (respostas dos clientes)
ADMIN_ORDER_EMAIL=             # recebe o aviso "Nova encomenda paga"

# --- Sendcloud (CTT / InPost) --------------------------------------------
SENDCLOUD_PUBLIC_KEY=          # Sendcloud → Settings → Integrations → API
SENDCLOUD_SECRET_KEY=
SENDCLOUD_WEBHOOK_SECRET=      # opcional: só se a integração tiver uma "Webhook signature key" própria
                               # (senão a assinatura do webhook usa SENDCLOUD_SECRET_KEY)

# --- Só para testes locais (netlify dev) — ignorados no site publicado --
# SENDCLOUD_MOCK=1             # envios, etiquetas e pontos de recolha simulados
# EMAIL_MOCK=1                 # emails guardados localmente em vez de enviados
